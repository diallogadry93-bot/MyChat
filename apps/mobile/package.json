{
  "name": "@mychat/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "MyChat mobile app — React Native (Expo)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf .expo *.tsbuildinfo",
    "test": "jest"
  },
  "dependencies": {
    "@mychat/shared": "workspace:*",
    "@mychat/ui": "workspace:*",
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "socket.io-client": "^4.7.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.0",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.4.0"
  }
}
