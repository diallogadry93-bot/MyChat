# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://mychat:mychat@localhost:5432/mychat_dev

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://:mychat_redis_dev@localhost:6379

# ── JWT Secrets (openssl rand -hex 32) ────────────────────
JWT_SECRET=change_me_use_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_me_use_openssl_rand_hex_32_different

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Cloudflare R2 (Phase 2) ───────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=mychat-media
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# ── AI features (Phase 4) ─────────────────────────────────
ANTHROPIC_API_KEY=
DEEPL_API_KEY=

# ── WebAuthn (Phase 1) ────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MyChat
WEBAUTHN_ORIGIN=http://localhost:3000

# ── mediasoup SFU (Phase 3) ───────────────────────────────
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1     # set to your server's public IP
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999
