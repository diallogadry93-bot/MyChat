# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://mychat:mychat@localhost:5432/mychat_dev

# Redis
REDIS_URL=redis://:mychat_redis_dev@localhost:6379

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_use_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_me_use_openssl_rand_hex_32_different

# CORS
CORS_ORIGIN=http://localhost:3000

# Cloudflare R2 (Phase 2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mychat-media
R2_PUBLIC_URL=

# AI (Phase 4)
ANTHROPIC_API_KEY=
DEEPL_API_KEY=

# WebAuthn (Phase 1)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MyChat
WEBAUTHN_ORIGIN=http://localhost:3000
