{
  "name": "@mychat/web",
  "version": "0.1.0",
  "private": true,
  "description": "MyChat web app — Next.js 14 + Tailwind CSS",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "clean": "rm -rf .next out *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@mychat/shared": "workspace:*",
    "@mychat/ui": "workspace:*",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "socket.io-client": "^4.7.4",
    "zod": "^3.22.0",
    "@hookform/resolvers": "^3.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
